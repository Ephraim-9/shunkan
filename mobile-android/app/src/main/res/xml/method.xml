<?xml version="1.0" encoding="utf-8"?>
<!--
  Input method metadata.

  Declaring the IME is what makes clipboard capture possible at all on
  Android 10+; see CAPTURE-DESIGN.md.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.shunkan.sync.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:name="@string/ime_name"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
</input-method>
