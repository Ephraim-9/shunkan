<?xml version="1.0" encoding="utf-8"?>
<!--
  Shunkan Android manifest.

  The component set here IS the capture design (ADR-006, F-35): an IME for
  capture, a share target for explicit sends, and a quick-settings tile for the
  toggle. See CAPTURE-DESIGN.md for why background clipboard reading is not an
  option on this platform.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network only. INV-02: no cloud, so no need for anything else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS-SD needs multicast on the local segment. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShunkanApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_tile"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shunkan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Shunkan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Share target: the user's explicit "send this to my desktop". This is
          the primary Android -> desktop path, by design rather than by
          limitation.
        -->
        <activity
            android:name=".share.ShareTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_to_shunkan"
            android:theme="@style/Theme.Shunkan.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Input method: the only component Android 10+ permits to observe the
          clipboard while not the focused app. Opt-in, and visible in Settings.
        -->
        <service
            android:name=".ime.ShunkanIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Quick-settings tile: toggle sync without opening the app. -->
        <service
            android:name=".tile.ShunkanTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Keeps the engine alive while sync is on. -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
