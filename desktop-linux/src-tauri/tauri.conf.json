{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shunkan",
  "version": "0.1.0",
  "identifier": "com.shunkan.sync",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "palette",
        "title": "Shunkan",
        "width": 720,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "P2P clipboard sync",
    "longDescription": "Shunkan (瞬間) — peer-to-peer clipboard and file sync over the local network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
