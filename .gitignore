# Rust
/target/
**/target/
# Cargo.lock is intentionally committed: this workspace ships binaries, so CI
# and every developer must resolve to the same dependency set. Without it a
# broken upstream release lands as an unreproducible failure and a security
# review has no fixed set to audit.

# Tauri generates capability schemas at build time.
desktop-linux/src-tauri/gen/schemas/

# Android build outputs generated by scripts/build-android.sh — the native
# library and the UniFFI bindings are derived from Rust source, never edited.
mobile-android/app/src/main/jniLibs/
mobile-android/app/src/main/java/uniffi/

# Android / Gradle
.gradle/
build/
**/build/
local.properties
*.iml
.idea/
.DS_Store

# Misc
*.log
